import pandas as pd
import numpy as np

# ----------------------------
# Example: your dataframe
# ----------------------------
# df = pd.read_excel("your_file.xlsx")

# Example expected columns:
# Name in Farsi, Name in English, Year, Age, Gender, City, Province, Source1
# If your source column is called something else, change SOURCE_COL below.

SOURCE_COL = "Source1"

# Columns used to identify the same person
GROUP_COLS = ["Name in Farsi"]

# Optional: if you want stricter grouping, use this instead:
# GROUP_COLS = ["Name in Farsi", "Year"]

# ----------------------------
# Helpers
# ----------------------------
def is_blank(x):
    return pd.isna(x) or str(x).strip() == ""

def clean_value(x):
    if pd.isna(x):
        return np.nan
    x = str(x).strip()
    return np.nan if x == "" else x

def choose_best_text(values):
    """
    Pick one non-empty value from a list.
    Current rule:
    - remove blanks
    - deduplicate while preserving order
    - prefer the longest string
    """
    cleaned = []
    seen = set()

    for v in values:
        if is_blank(v):
            continue
        s = str(v).strip()
        if s not in seen:
            cleaned.append(s)
            seen.add(s)

    if not cleaned:
        return np.nan

    # choose longest non-empty value
    return max(cleaned, key=len)

def choose_best_numeric(values):
    """
    Pick first non-empty numeric-like value.
    """
    for v in values:
        if not is_blank(v):
            return v
    return np.nan

def consolidate_group(group, source_col="Source1"):
    result = {}

    # all columns except source column
    normal_cols = [c for c in group.columns if c != source_col]

    for col in normal_cols:
        vals = group[col].tolist()

        # numeric-ish columns where first non-empty is usually enough
        if col in ["Year", "Age"]:
            result[col] = choose_best_numeric(vals)
        else:
            result[col] = choose_best_text(vals)

    # collect unique non-empty sources
    sources = []
    seen = set()
    for v in group[source_col]:
        if is_blank(v):
            continue
        s = str(v).strip()
        if s not in seen:
            sources.append(s)
            seen.add(s)

    # write them as Source1, Source2, Source3...
    for i, src in enumerate(sources, start=1):
        result[f"Source{i}"] = src

    return pd.Series(result)

# ----------------------------
# Main consolidation
# ----------------------------
def merge_duplicate_people(df, group_cols, source_col="Source1"):
    df = df.copy()

    # Clean blanks
    for col in df.columns:
        df[col] = df[col].apply(clean_value)

    merged = (
        df.groupby(group_cols, dropna=False, as_index=False)
          .apply(lambda g: consolidate_group(g, source_col=source_col))
          .reset_index(drop=True)
    )

    return merged

# ----------------------------
# Run
# ----------------------------
merged_df = merge_duplicate_people(df, GROUP_COLS, SOURCE_COL)

print(merged_df)



