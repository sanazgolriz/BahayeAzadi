import pandas as pd
from rapidfuzz import fuzz
COLUMN = "Name in Farsi"
FUZZY_THRESHOLD = 92  # very high similarity
def normalize(text):
    if pd.isna(text):
        return ""
    return str(text).strip().lower()
def find_similar_names(df):
    names = df[COLUMN].apply(normalize).tolist()
    results = []

    n = len(names)

    for i in range(n):
        for j in range(i + 1, n):  # avoid self + duplicate comparisons
            name1 = names[i]
            name2 = names[j]

            if not name1 or not name2:
                continue

            # Exact match
            exact = name1 == name2

            # Fuzzy match
            similarity = fuzz.ratio(name1, name2)
            fuzzy = similarity >= FUZZY_THRESHOLD

            if exact or fuzzy:
                results.append({
                    "index_1": i,
                    "index_2": j,
                    "name_1": df.iloc[i][COLUMN],
                    "name_2": df.iloc[j][COLUMN],
                    "similarity": similarity,
                    "row_1": df.iloc[i],
                    "row_2": df.iloc[j],
                })

    return results
def print_results(matches):
    for k, match in enumerate(matches, 1):
        print(f"\n========== MATCH {k} ==========")
        print(f"Similarity: {match['similarity']}")
        print(f"""{match["name_1"]} == {match["name_2"]}\n""")
matches = find_similar_names(df)


listofnames = []
for k, match in enumerate(matches, 1):
    if match['similarity'] == 100:
        listofnames.append(match["name_1"])

print(len(set(listofnames)))




a = pd.DataFrame()
a['col'] = listofnames
a.drop_duplicates().to_csv("test.csv")


