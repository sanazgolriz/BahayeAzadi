from pathlib import Path
import re

PHOTOS_DIR = Path(r"C:\Users\sanaz\Downloads\Telegram Desktop\ChatExport_2026-03-10\extracted_results\photos")

def normalize(text):
    """Normalize text for safer matching"""
    text = text.strip()
    text = re.sub(r'\s+', ' ', text)
    return text

def build_mapping(mapping_text):
    mapping = {}
    for line in mapping_text.strip().splitlines():
        if not line.strip():
            continue
        parts = re.split(r'\t+', line.strip())
        if len(parts) != 2:
            continue
        fa, en = normalize(parts[0]), normalize(parts[1])
        mapping[fa] = en
    return mapping

def rename_files():
    mapping = build_mapping(MAPPING_TEXT)

    renamed = 0
    not_found = []

    for file in PHOTOS_DIR.glob("*.jpg"):
        fa_name = normalize(file.stem)

        if fa_name in mapping:
            new_name = mapping[fa_name] + ".jpg"
            new_path = file.with_name(new_name)

            # Avoid overwriting
            if new_path.exists():
                print(f"⚠️ Skipping (exists): {new_name}")
                continue

            file.rename(new_path)
            print(f"✅ {file.name} → {new_name}")
            renamed += 1
        else:
            not_found.append(file.name)

    print(f"\nDone. Renamed: {renamed}")
    if not_found:
        print("\n❌ Not found in mapping:")
        for n in not_found:
            print(n)

if __name__ == "__main__":
    rename_files()








