def normalize(text):
    return re.sub(r'\s+', ' ', text.strip())

def move_files_only():
    moved = 0
    skipped = []
    for file in PHOTOS_DIR.glob("*_.jpg"):
        # Example:
        # file.name = "علی رضایی_.jpg"
        # file.stem = "علی رضایی_"
        folder_name = re.sub(r'_$', '', file.stem)
        folder_name = normalize(folder_name)
        target_folder = PHOTOS_DIR / folder_name
        if not target_folder.exists() or not target_folder.is_dir():
            print(f"⚠️ Folder not found: {target_folder}")
            skipped.append(file.name)
            continue
        target_path = target_folder / file.name  # keep original filename unchanged
        if target_path.exists():
            print(f"⚠️ Skipping, file already exists: {target_path}")
            skipped.append(file.name)
            continue
        shutil.move(str(file), str(target_path))
        print(f"✅ Moved: {file.name} → {target_folder}")
        moved += 1
    print(f"\nDone. Moved: {moved}")
    if skipped:
        print("\nSkipped:")
        for s in skipped:
            print(s)

if __name__ == "__main__":
    move_files_only()





